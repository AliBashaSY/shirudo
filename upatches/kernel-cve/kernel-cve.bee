[package]
name = "kernel-cve-upatches"
description = "Exported shirudo kernel CVE upatch sources"
license = "GPL-2.0 OR BSD-2-Clause"
authors = ["shirudo Campaign Export"]

[[upatches]]
source = "sources/cve-2025-71093-e1000-oob-e1000-tbi-should-accept/observability/cve-2025-71093-e1000-tbi-detector.bpf.c"
load_target = "upatches/cve-2025-71093-e1000-oob-e1000-tbi-should-accept.upatch"

[upatches.tree]
id = "cve-2025-71093-e1000-oob-e1000-tbi-should-accept"
load_artifact = "upatches/cve-2025-71093-e1000-oob-e1000-tbi-should-accept.upatch"
unload_artifact = "upatches/cve-2025-71093-e1000-oob-e1000-tbi-should-accept.unload.upatch"

[upatches.tree.selector]
kernel_release_prefix = ["7.2"]
kernel_build_id = ["534043106db415bc0a983a3393e06c81b431bd39"]
architecture = ["x86_64"]

[upatches.tree.selector.kconfig]
CONFIG_E1000 = ["y", "m"]

[[upatches]]
source = "sources/cve-2026-31675-net-sched-sch-netem-oob-access-packet-corruption/observability/cve-2026-31675-netem-detector.bpf.c"
load_target = "upatches/cve-2026-31675-net-sched-sch-netem-oob-access-packet-corruption.upatch"

[upatches.tree]
id = "cve-2026-31675-net-sched-sch-netem-oob-access-packet-corruption"
load_artifact = "upatches/cve-2026-31675-net-sched-sch-netem-oob-access-packet-corruption.upatch"
unload_artifact = "upatches/cve-2026-31675-net-sched-sch-netem-oob-access-packet-corruption.unload.upatch"

[upatches.tree.selector]
kernel_release_prefix = ["7.2"]
kernel_build_id = ["534043106db415bc0a983a3393e06c81b431bd39"]
architecture = ["x86_64"]

[upatches.tree.selector.kconfig]
CONFIG_NET_SCH_NETEM = ["y", "m"]

[[upatches]]
source = "sources/cve-2026-63984-ipv6-rpl-hdrlen-overflow-ipv6-rpl-srh-decompress/observability/cve-2026-63984-rpl-detector.bpf.c"
load_target = "upatches/cve-2026-63984-ipv6-rpl-hdrlen-overflow-ipv6-rpl-srh-decompress.upatch"

[upatches.tree]
id = "cve-2026-63984-ipv6-rpl-hdrlen-overflow-ipv6-rpl-srh-decompress"
load_artifact = "upatches/cve-2026-63984-ipv6-rpl-hdrlen-overflow-ipv6-rpl-srh-decompress.upatch"
unload_artifact = "upatches/cve-2026-63984-ipv6-rpl-hdrlen-overflow-ipv6-rpl-srh-decompress.unload.upatch"

[upatches.tree.selector]
kernel_release_prefix = ["7.2"]
kernel_build_id = ["534043106db415bc0a983a3393e06c81b431bd39"]
architecture = ["x86_64"]

[upatches.tree.selector.kconfig]
CONFIG_IPV6 = ["y", "m"]
